# Unipi common: block, RAID/DM, SCSI/iSCSI, filesystems, zram, MMC
# CONFIG_SCSI_PROC_FS is not set
CONFIG_AUTOFS_FS=m
CONFIG_BLK_DEV_DM=m
CONFIG_BLK_DEV_INTEGRITY=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_MD=m
CONFIG_BLK_DEV_NBD=m
CONFIG_BLK_DEV_SD=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_CUSE=m
CONFIG_DM_MIRROR=m
CONFIG_DM_ZERO=m
CONFIG_EXFAT_FS=m
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_FUSE_FS=m
CONFIG_ISCSI_BOOT_SYSFS=m
CONFIG_ISCSI_TCP=m
CONFIG_MD=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_NFS_FS=y
CONFIG_NFS_V4=y
CONFIG_NFS_V4_1=y
CONFIG_NFS_V4_2=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_OVERLAY_FS=y
CONFIG_RAID_ATTRS=m
CONFIG_ROOT_NFS=y
CONFIG_SCSI=y
CONFIG_SCSI_ISCSI_ATTRS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_VFAT_FS=y
CONFIG_ZRAM=m
