# Upstream definition — the single source of truth for the build and
# for the SBOM component generator. Sourced by prepare.sh and
# parsed by debian/scripts/gen-component-sbom.
#
# TAG        : the CIP SLTS kernel tag we fetch and fork
# CIP_REPO   : the CIP kernel git repository (base for the snapshot URL)
# STABLE_REPO: the Linux stable git repository (the mainline ancestor)
# ADVISORIES : the CIP kernel security CVE tracker (authoritative feed)

TAG=6.12.111-cip32
CIP_REPO=https://git.kernel.org/pub/scm/linux/kernel/git/cip/linux-cip.git
STABLE_REPO=https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
ADVISORIES=https://gitlab.com/cip-project/cip-kernel/cip-kernel-sec
